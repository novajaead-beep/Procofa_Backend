<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Procofa.Infrastructure: → Procofa.Application, → Procofa.Domain
    (Instrucción 02, sección 4).

    Persistencia (Instrucción 03): EF Core + Npgsql para representar el
    baseline PostgreSQL V2.1 existente. Microsoft.EntityFrameworkCore.Design
    es PrivateAssets="all" — herramienta de diseño (dotnet ef) para poder
    generar/inspeccionar migraciones desde este proyecto, sin filtrarse como
    dependencia runtime hacia quien referencie Infrastructure.
  -->

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Instrucción 04: hashing (PasswordHasher<TUser>) + emisión de JWT. -->
    <PackageReference Include="Microsoft.Extensions.Identity.Core" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
    <!--
      Instrucción 04.2 — CERRAR AUTH: IConfiguration/GetConnectionString(...)
      resueltos de forma diferida dentro de AddDbContext (ver
      DependencyInjection.cs). Classlib puro sin framework compartido de
      ASP.NET Core, así que se referencian explícitamente.
    -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Procofa.Application\Procofa.Application.csproj" />
    <ProjectReference Include="..\Procofa.Domain\Procofa.Domain.csproj" />
  </ItemGroup>

</Project>
